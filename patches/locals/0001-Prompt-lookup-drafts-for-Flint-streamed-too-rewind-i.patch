+
+        if type(getattr(self.lm, "model", None)).__module__.rsplit(".", 1)[-1] not in ("flint", "flint_streamed"):
+            return False
+        return all(type(c) in (BatchKVCache, ArraysCache, BatchRotatingKVCache, BatchQuantizedKVCache) for c in cache)
+
     def _solo_drafts_ok(self, cache) -> bool:
