+@pytest.mark.model
+def test_a_rejected_draft_rewound_leaves_no_trace_in_recursives_build():
+    """A draft verified in one pass and rejected (HybridBatchEngine._solo_rewind) leaves the caches as if it had never
+    been fed, its sliding-window rings wrapped past their 513 tokens: the steps after it, one token or several, give
+    the same logits whatever the rejected tokens were (the ring kept them in its window before)."""
+    from huggingface_hub import snapshot_download
+    from mlx_lm.models.cache import make_prompt_cache
+
+    from locals.hybrid_batch import HybridBatchEngine
+    from locals.kernels import head_logits
+    from locals.runtime import Runtime
+
+    try:
+        snapshot_download("RecursiveSI/flint-int4", local_files_only=True)
+    except Exception:  # noqa: BLE001
+        pytest.skip("RecursiveSI/flint-int4 is not in the local cache")
+    rt = Runtime.load("RecursiveSI/flint-int4", tune="auto")
+    prompt = rt.encode_chat("Count from 1 to 400 in words, comma separated: " + ", ".join(map(str, range(1, 240))))
+    assert len(prompt) > 600
+    rewind = HybridBatchEngine.__new__(HybridBatchEngine)._solo_rewind
+    feed = [prompt[-1]] + [int(t) for t in rt.encode_chat("one, two, three, four, five, six, seven")[-12:]]
+
+    def steps(junk):
+        c = [x.merge([x]) for x in make_prompt_cache(rt.model)]
+        mx.eval(rt.model.model(mx.array([prompt[:-1]]), c))
+        out = []
+        for s in range(0, len(feed) - 2, 3):  # two tokens and a rejected draft in one pass, then a one-token step
+            out.append(head_logits(rt.model, rt.model.model(mx.array([feed[s:s + 2] + junk]), c))[0, :2])
+            rewind(c, len(junk))
+            out.append(head_logits(rt.model, rt.model.model(mx.array([feed[s + 2:s + 3]]), c))[0])
+            mx.eval(out)
+        return mx.concatenate(out)
+
+    assert mx.array_equal(steps([11, 12, 13]), steps([500, 7000, 42])).item()
