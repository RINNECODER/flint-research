@@ -0,0 +1,215 @@
+"""DFlash 2 drafts for Flint (incoai/Flint-DFlash2; the model from z-lab/dflash, MIT, ported from its model_mlx.py).
+
+A 5-layer block-diffusion drafter (0.4B, bf16) that proposes a block of 7 tokens in one pass: the token about to
+be fed, then 7 mask tokens, attending to Flint's own hidden states (layers 5, 15, 26, 36, 46, concatenated and
+projected) at the last 2047 tokens it has fed. It keeps the top 16 candidates at each position and a low-rank
+selector walks one path through them. Flint's embedding and head are shared (only the body is loaded).
+
+The target's hidden states come from a tape FlintModel keeps while drafts are on (flint_streamed.FlintModel._tape:
+inputs and tapped layers of each one-row pass); a request's context is matched against it by token, so passes of
+other rows or prefixes restored from the cache only leave a gap (its positions are skipped).
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import List, Optional
+
+import mlx.core as mx
+import mlx.nn as nn
+from mlx_lm.models.qwen3 import MLP
+from mlx_lm.models.rope_utils import initialize_rope
+
+from .kernels import head_logits
+
+REPO = "incoai/Flint-DFlash2"
+
+
+class Attention(nn.Module):
+    def __init__(self, cfg: dict):
+        super().__init__()
+        d, hd = cfg["hidden_size"], cfg["head_dim"]
+        self.n_heads, self.n_kv = cfg["num_attention_heads"], cfg["num_key_value_heads"]
+        self.scale = hd ** -0.5
+        self.window = cfg["sliding_window"]
+        self.q_proj = nn.Linear(d, self.n_heads * hd, bias=False)
+        self.k_proj = nn.Linear(d, self.n_kv * hd, bias=False)
+        self.v_proj = nn.Linear(d, self.n_kv * hd, bias=False)
+        self.o_proj = nn.Linear(self.n_heads * hd, d, bias=False)
+        self.q_norm = nn.RMSNorm(hd, eps=cfg["rms_norm_eps"])
+        self.k_norm = nn.RMSNorm(hd, eps=cfg["rms_norm_eps"])
+
+    def __call__(self, x, x_ctx, rope, kv: list, pos: int):
+        """kv: [keys, values] of this layer's context (after RoPE, oldest first), extended by x_ctx at ``pos``
+        and kept to window - 1; the block x follows the context at pos + len(x_ctx)."""
+        B, L, _ = x.shape
+        S = x_ctx.shape[1]
+
+        def heads(t, n, norm=None):
+            t = t.reshape(B, t.shape[1], n, -1)
+            return (norm(t) if norm is not None else t).transpose(0, 2, 1, 3)
+
+        q = rope(heads(self.q_proj(x), self.n_heads, self.q_norm), offset=pos + S)
+        if S:
+            ck = rope(heads(self.k_proj(x_ctx), self.n_kv, self.k_norm), offset=pos)
+            cv = heads(self.v_proj(x_ctx), self.n_kv)
+            ck = ck if kv[0] is None else mx.concatenate([kv[0], ck], axis=2)
+            cv = cv if kv[1] is None else mx.concatenate([kv[1], cv], axis=2)
+            kv[0], kv[1] = ck[:, :, -(self.window - 1):], cv[:, :, -(self.window - 1):]
+        n = 0 if kv[0] is None else kv[0].shape[2]
+        pk = rope(heads(self.k_proj(x), self.n_kv, self.k_norm), offset=pos + S)
+        pv = heads(self.v_proj(x), self.n_kv)
+        keys = pk if not n else mx.concatenate([kv[0], pk], axis=2)
+        values = pv if not n else mx.concatenate([kv[1], pv], axis=2)
+        # the block sees itself whole (not causal) and the context within the window of each query
+        query, key = n + mx.arange(L)[:, None], mx.arange(n + L)[None]
+        mask = (key >= n) | (query - key < self.window)
+        out = mx.fast.scaled_dot_product_attention(q, keys, values, scale=self.scale, mask=mask)
+        return self.o_proj(out.transpose(0, 2, 1, 3).reshape(B, L, -1))
+
+
+def _dyn_conv(hidden, dynamic, base, group):
+    """Two-tap causal convolution along the block, its kernel per group of channels: a learned base plus a
+    per-token part (dynamic)."""
+    B, L, D = hidden.shape
+    blocks = hidden.reshape(B, L, D // group, group)
+    dynamic = dynamic.reshape(B, L, base.shape[0], D // group, 1)
+    out = mx.zeros_like(blocks)
+    for o in range(base.shape[0]):
+        v = blocks if o == 0 else mx.concatenate((mx.zeros_like(blocks[:, :o]), blocks[:, :-o]), axis=1)
+        out = out + (base[o].reshape(1, 1, D // group, group).astype(hidden.dtype) + dynamic[:, :, o]) * v
+    return out.reshape(hidden.shape)
+
+
+class Conv(nn.Module):
+    def __init__(self, d: int, k: int, group: int):
+        super().__init__()
+        self.k, self.group = k, group
+        self.base_kernel = mx.zeros((2, k, d))
+        self.kernel_projection = nn.Linear(d, 2 * k * (d // group), bias=False)
+
+    def prepare(self, h):
+        dyn = self.kernel_projection(h).reshape(*h.shape[:-1], 2, self.k, h.shape[-1] // self.group)
+        return _dyn_conv(h, dyn[..., 0, :, :], self.base_kernel[0], self.group), dyn[..., 1, :, :]
+
+    def finish(self, h, dyn):
+        return _dyn_conv(h, dyn, self.base_kernel[1], self.group)
+
+
+class Layer(nn.Module):
+    def __init__(self, cfg: dict, dc: dict):
+        super().__init__()
+        d = cfg["hidden_size"]
+        self.self_attn = Attention(cfg)
+        self.mlp = MLP(d, cfg["intermediate_size"])
+        self.input_layernorm = nn.RMSNorm(d, eps=cfg["rms_norm_eps"])
+        self.post_attention_layernorm = nn.RMSNorm(d, eps=cfg["rms_norm_eps"])
+        self.attention_conv = Conv(d, dc["conv_kernel_size"], dc["conv_group_size"])
+        self.mlp_conv = Conv(d, dc["conv_kernel_size"], dc["conv_group_size"])
+
+    def __call__(self, x, x_ctx, rope, kv, pos):
+        x2, k = self.attention_conv.prepare(self.input_layernorm(x))
+        x = x + self.attention_conv.finish(self.self_attn(x2, x_ctx, rope, kv, pos), k)
+        x2, k = self.mlp_conv.prepare(self.post_attention_layernorm(x))
+        return x + self.mlp_conv.finish(self.mlp(x2), k)
+
+
+class Selector(nn.Module):
+    def __init__(self, cfg: dict, dc: dict):
+        super().__init__()
+        self.top_k = dc["selector_top_k"]
+        self.predecessor_codebook = nn.Embedding(cfg["vocab_size"], dc["selector_rank"])
+        self.successor_codebook = nn.Embedding(cfg["vocab_size"], dc["selector_rank"])
+        self.hidden_projection = nn.Linear(cfg["hidden_size"], dc["selector_rank"], bias=False)
+
+    def __call__(self, hidden, logits, anchor):
+        """Greedy path through the top-k candidates at each position: unary logit + a low-rank edge score from
+        the previous pick (``anchor``: the token before the block)."""
+        cand = mx.argpartition(logits, -self.top_k, axis=-1)[..., -self.top_k:]
+        unary = mx.take_along_axis(logits, cand, axis=-1)
+        hidden = self.hidden_projection(hidden)
+        prev, path = anchor, []
+        for p in range(hidden.shape[1]):
+            edges = mx.sum(self.predecessor_codebook(prev)[:, None] * hidden[:, p, None]
+                           * self.successor_codebook(cand[:, p]), axis=-1)
+            pick = mx.argmax(unary[:, p] + edges, axis=-1)
+            prev = mx.take_along_axis(cand[:, p], pick[:, None], axis=-1)[:, 0]
+            path.append(prev)
+        return mx.stack(path, axis=1)
+
+
+class Drafter(nn.Module):
+    def __init__(self, cfg: dict):
+        super().__init__()
+        dc = cfg["dflash_config"]
+        d = cfg["hidden_size"]
+        self.block = dc["block_size"]
+        self.mask_id = dc["mask_token_id"]
+        self.target_layers = list(dc["target_layer_ids"])
+        self.window = cfg["sliding_window"]
+        self.fc = nn.Linear(len(self.target_layers) * d, d, bias=False)
+        self.hidden_norm = nn.RMSNorm(d, eps=cfg["rms_norm_eps"])
+        self.layers = [Layer(cfg, dc) for _ in range(cfg["num_hidden_layers"])]
+        self.norm = nn.RMSNorm(d, eps=cfg["rms_norm_eps"])
+        self.candidate_selector = Selector(cfg, dc)
+        rp = cfg.get("rope_parameters") or {}
+        self.rope = initialize_rope(cfg["head_dim"], rp.get("rope_theta", 10000.0), False, None,
+                                    cfg["max_position_embeddings"])
+
+    def propose(self, lm, st: "State", x: int, ctx: Optional[mx.array]) -> mx.array:
+        """The drafted block after token ``x`` (1, block - 1), ``ctx``: Flint's tapped hidden states (1, S, 5 * D)
+        at the tokens fed since the last call (st.pos: the position of the first)."""
+        ids = mx.array([[x] + [self.mask_id] * (self.block - 1)], dtype=mx.int32)
+        h = lm.model.embed_tokens(ids)
+        hc = self.hidden_norm(self.fc(ctx)) if ctx is not None else h[:, :0]
+        for layer, kv in zip(self.layers, st.kv):
+            h = layer(h, hc, self.rope, kv, st.pos)
+        st.pos += hc.shape[1]
+        h = self.norm(h[:, 1:])
+        return self.candidate_selector(h, head_logits(lm, h), ids[:, 0])
+
+
+class State:
+    """A request's drafter context: each layer's context keys and values, the position of the next context
+    token, and how many of the request's stream tokens it has seen (fed to it or skipped)."""
+
+    def __init__(self, n_layers: int):
+        self.kv = [[None, None] for _ in range(n_layers)]
+        self.pos = 0
+        self.seen = 0
+
+
+def load(repo: str = REPO) -> Drafter:
+    from huggingface_hub import snapshot_download
+
+    path = Path(snapshot_download(repo, allow_patterns=["*.json", "*.safetensors"]))
+    cfg = json.loads((path / "config.json").read_text())
+    w = {k: v for f in path.glob("*.safetensors") for k, v in mx.load(str(f)).items()}
+    for k in ("candidate_selector.predecessor_codebook", "candidate_selector.successor_codebook"):
+        w[k + ".weight"] = w.pop(k)  # (stored as bare parameters)
+    m = Drafter(cfg)
+    m.load_weights(list(w.items()))
+    m.eval()
+    mx.eval(m.parameters())
+    return m
+
+
+def context(tape: list, stream: List[int], st: State, window: int):
+    """Flint's hidden states at the stream tokens the drafter has not seen, from the tape's matching tail (the
+    tokens before it are skipped: their positions stay, their states are missing). Returns (hidden or None)."""
+    need = min(len(stream) - st.seen, window - 1)
+    got, k = [], 0
+    for toks, hid in reversed(tape):
+        t = toks[0].tolist() if isinstance(toks, mx.array) else toks
+        m = 0
+        while m < len(t) and k + m < need and t[len(t) - 1 - m] == stream[len(stream) - 1 - k - m]:
+            m += 1
+        if m:
+            got.append(hid[:, len(t) - m:])
+            k += m
+        if m < len(t) or k >= need:
+            break
+    st.pos += len(stream) - st.seen - k  # the skipped tokens' positions
+    st.seen = len(stream)
+    return mx.concatenate(got[::-1], axis=1) if got else None
