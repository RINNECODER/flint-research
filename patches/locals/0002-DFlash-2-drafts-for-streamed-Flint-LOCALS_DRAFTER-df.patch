+++ b/tests/test_dflash.py
@@ -0,0 +1,24 @@
+"""DFlash drafts (locals/dflash.py): a request's drafter context comes from FlintModel's tape of one-row passes."""
+import mlx.core as mx
+
+from locals import dflash
+
+
+def _states(toks, tag):
+    return mx.array([[[tag * 100 + t] for t in toks]], dtype=mx.float32)
+
+
+def test_the_context_is_the_tapes_matching_tail_and_what_it_misses_a_gap():
+    """The tape's tail that matches the request's fed tokens gives their states, oldest first; a pass of another row
+    ends the match, and the tokens before it keep their positions with no states (the drafter's RoPE stays aligned).
+    The next call gives only the tokens fed since."""
+    tape = [(mx.array([[1, 2, 3]]), _states([1, 2, 3], 1)), (mx.array([[9, 9]]), _states([9, 9], 2)),
+            (mx.array([[4, 5]]), _states([4, 5], 1)), (mx.array([[6]]), _states([6], 1))]
+    st = dflash.State(1)
+    ctx = dflash.context(tape, [0, 1, 2, 3, 4, 5, 6], st, window=2048)
