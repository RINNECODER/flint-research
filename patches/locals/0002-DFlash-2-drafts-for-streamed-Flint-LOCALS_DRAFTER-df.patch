+def test_the_tape_holds_each_fed_tokens_layer_states_however_the_step_ran(tmp_path, monkeypatch):
+    """DFlash drafts (locals/dflash.py) read Flint's states at the layers they name from a tape of one-row passes.
+    One-token steps whose windows of layers resume after a missing expert (3 slots a layer: they miss all the time,
+    and the layers after the miss are computed again) tape what one pass over the whole stream computes."""
+    import mlx_lm.utils as mlx_utils
+
+    monkeypatch.setattr(flint, "OPTIMISTIC", "always")
+    _save_wide(tmp_path)
+    model, _ = mlx_utils.load_model(tmp_path)
+    model.expert_store.slots = 3
+    model.expert_store.reset()
+    restores = []
+    restore = flint._restore
+    monkeypatch.setattr(flint, "_restore", lambda *a: restores.append(1) or restore(*a))
+    body = model.model
+    body._taps, body._tapped, body._tape = {0: 0, 2: 1}, [None, None], []
+    tokens = [3, 17, 42, 5, 88, 9, 61, 2, 33, 70, 11, 4]
+    cache = model.make_cache()
+    for t in tokens:
+        mx.eval(model(mx.array([[t]]), cache=cache))
+    assert restores and [x[0].tolist() for x, _ in body._tape] == [[t] for t in tokens]
+    got = mx.concatenate([h for _, h in body._tape], axis=1).astype(mx.float32)
+    body._tape = []
+    monkeypatch.setattr(flint, "OPTIMISTIC", "0")
+    model(mx.array([tokens]), cache=model.make_cache())
+    want = body._tape[0][1].astype(mx.float32)
+    assert got.shape == want.shape == (1, len(tokens), 2 * 512)
+    assert float(mx.max(mx.abs(got - want))) <= 0.05 * (1 + float(mx.max(mx.abs(want))))
